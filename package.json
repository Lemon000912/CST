{
  "name": "quantum-pinnacle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:kill": "node scripts/dev-kill.mjs",
    "dev:fresh": "npm run dev:kill && npm run dev",
    "dev:client": "vite --config frontend/vite.config.ts",
    "dev:server": "node backend/index.js",
    "start:bg": "bash scripts/start-bg.sh",
    "stop:bg": "bash scripts/stop-bg.sh",
    "install:service": "bash scripts/install-systemd-user.sh",
    "install:prod": "bash scripts/install-prod.sh",
    "update:prod": "bash scripts/update-prod.sh",
    "pdf:sync": "node scripts/sync-server-pdfs.mjs",
    "pdf:sync:watch": "node scripts/sync-server-pdfs.mjs --watch",
    "build": "npx tsc -p frontend/tsconfig.json --noEmit && vite build --config frontend/vite.config.ts",
    "test": "node --test backend/test/*.test.js",
    "preview": "vite preview --config frontend/vite.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@volcengine/openapi": "^1.36.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "mermaid": "^11.15.0",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.20.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "sql.js": "^1.12.0",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.2",
    "vite": "^5.4.10"
  }
}
