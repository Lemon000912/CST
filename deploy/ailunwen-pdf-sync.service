[Unit]
Description=Ailunwen server PDF library incremental sync
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=%USER%
WorkingDirectory=%WORKDIR%
Environment=PATH=%NODE_BIN%:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
EnvironmentFile=-/home/ubuntu/ailunwen-secrets/ailunwen.env
ExecStart=%NODE_BIN%/node scripts/sync-server-pdfs.mjs --watch
Restart=on-failure
RestartSec=10
Nice=10
IOSchedulingClass=idle
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
