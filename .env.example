# 本地配置：复制为 .env 后填写密钥（.env 已在 .gitignore，勿提交）
#   copy .env.example .env
# Linux / macOS 若无可写 .env，也可用 export 设置同名变量。

# 程序版本由后端进程固定。双版本生产服务会分别设置为 school / enterprise。
# APP_EDITION=school
# 校园版和企业版的默认开发端口。
# SCHOOL_API_PORT=8787
# ENTERPRISE_API_PORT=8788
# SCHOOL_DEV_PORT=5175
# ENTERPRISE_DEV_PORT=5176

# 兼容单版本启动的 HTTP 监听端口（默认 8787）。
# PORT=8787
# 兼容单版本启动的开发前端端口（默认 5175）。
# VITE_DEV_PORT=5175

# 用户登录 JWT 签名密钥（生产环境必填）。建议随机字符串 ≥32 字符；勿泄露、勿提交到仓库。
# 未设置时开发环境会使用内置占位密钥并打日志警告。
# JWT_SECRET=
# Comma-separated existing usernames allowed to access /api/v1/admin/*.
# This is an account allow-list, not a password. Production must set it explicitly.
# ADMIN_USERNAMES=admin

# 企业版首次启动时自动创建的默认管理员（仅当账号不存在时创建，不会覆盖已有密码）。
# 生产环境首次登录后请立即修改密码；可通过服务器私密环境文件覆盖这两个值。
# ENTERPRISE_ADMIN_USERNAME=admin
# ENTERPRISE_ADMIN_PASSWORD=admin123

# ---------- 火山引擎短信注册验证码 ----------
# 官方 Node.js SDK 使用的访问密钥。生产环境只写入服务器私密 env，禁止提交真实值。
# VOLC_ACCESSKEY=
# VOLC_SECRETKEY=
# 消息组 ID、已审核签名、验证码模板 ID（模板类型必须为 CN_OTP 或 I18N_OTP）。
# VOLC_SMS_ACCOUNT=
# VOLC_SMS_SIGN=
# VOLC_SMS_TEMPLATE_ID=ST_xxx
# Scene 会同时参与发送和校验，必须保持一致；它不是控制台生成的 ID。
VOLC_SMS_SCENE=CST_REGISTER
# 可选参数：验证码长度仅支持 4/6/8，有效期 180～1800 秒，重试次数 1～10。
VOLC_SMS_CODE_TYPE=6
VOLC_SMS_EXPIRE_SECONDS=300
VOLC_SMS_TRY_COUNT=5
# VOLC_SMS_USER_EXT_CODE=
# VOLC_SMS_TAG=CST_REGISTER

# ---------- 微信开放平台网站应用扫码登录 ----------
# 与微信支付配置相互独立。AppSecret 只能放在服务端私密 env，禁止写入前端或提交仓库。
# 微信开放平台「网站应用」中将授权回调域设置为 syncsee.cstdata.net。
# WECHAT_OPEN_APP_ID=wx...
# WECHAT_OPEN_APP_SECRET=
# WECHAT_OPEN_REDIRECT_URI=https://syncsee.cstdata.net/api/v1/auth/wechat/callback
# 授权结束后返回的前端首页；不填时默认使用回调地址的同源根路径。
# WECHAT_OPEN_FRONTEND_URL=https://syncsee.cstdata.net/

# ---------- 积分充值扫码支付（固定套餐：100 元 = 1000 积分）----------
# 公网 HTTPS 地址，不要以 / 结尾；支付宝/微信会回调此地址下的 /api/v1/billing/recharge/callback/*。
# PAYMENT_NOTIFY_BASE_URL=https://your-domain.example.com

# 支付宝「当面付」应用。PUBLIC_KEY 必须是支付宝公钥，不是应用公钥。
# 密钥既可直接填写（换行写成 \n），也建议通过对应的 *_FILE 指向服务器 PEM 文件。
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY_FILE=/run/secrets/alipay_app_private_key.pem
# ALIPAY_PUBLIC_KEY_FILE=/run/secrets/alipay_public_key.pem
# 可选：额外校验回调 seller_id。
# ALIPAY_SELLER_ID=
# 沙箱联调时启用；生产环境不填则使用正式网关。
# ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# 微信支付 API v3「Native 支付」。平台公钥可填写微信支付平台证书 PEM。
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_MERCHANT_SERIAL_NO=
# WECHAT_PAY_PRIVATE_KEY_FILE=/run/secrets/wechat_merchant_private_key.pem
# WECHAT_PAY_PLATFORM_PUBLIC_KEY_FILE=/run/secrets/wechatpay_platform_cert.pem
# WECHAT_PAY_PLATFORM_SERIAL_NO=
# WECHAT_PAY_API_V3_KEY=

# 主 LLM（OpenAI 兼容 Chat Completions）：查询改写、语义理解、作图、数据表、书籍回答、Deep Mine 终稿等单任务。
# URL 可填 API base（如 https://api.openai.com/v1）或完整 /chat/completions 地址；服务端会规范化。
# LLM_API_KEY=
# LLM_CHAT_COMPLETIONS_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 语义理解（检索前 LLM 解析材料/性能/同义词，并参与相关度排序；默认在已配置 LLM_API_KEY 时开启）
# SEMANTIC_UNDERSTAND_ENABLED=1
# 完全关闭语义理解（仅用 token 匹配）
# SEMANTIC_UNDERSTAND_DISABLED=1
# SEMANTIC_UNDERSTAND_TIMEOUT_MS=8000
# 可选：OpenAI 兼容 Embeddings 向量重排（网关须支持 /v1/embeddings）
# SEMANTIC_EMBEDDING_ENABLED=1
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_MODEL=text-embedding-3-small
# SEMANTIC_EMBED_RERANK_CAP=40

# 开发：设为 1 时，启动 API 若库中尚无该用户则创建测试登录账号（勿在生产环境开启）
# 默认 用户名 admin、密码 TestAdmin_888；可用下面两行覆盖
# SEED_DEV_ADMIN=1
# DEV_ADMIN_USERNAME=admin
# DEV_ADMIN_PASSWORD=TestAdmin_888
# DEV_ADMIN_UNLIMITED_POINTS=1

# ---------- 网页渠道「全网」来源（默认不用 Bing）----------
# 网页渠道默认：原通用搜索 + Wikipedia + CORE；Semantic Scholar 保留在数据库渠道
# WEB_SOURCES=tavily,dataify,searx,ddg,qwant,mojeek,wikipedia,core
# 可选扩展源：tavily、mcp（Brave）；bing 须 WEB_USE_BING=1
# 启用 Bing HTML 爬取（默认关闭）
# WEB_USE_BING=0
# 各网页源无结果时自动用 cn.bing.com（国内网络建议保持 1）
# WEB_CN_BING_FALLBACK=1
# 网页渠道是否同时查专利（0=仅全网网页，不查 OpenAlex 专利索引）
# WEB_CHANNEL_PATENTS=1
# ---------- 联网回答准确性（推荐）----------
# 0=摘录不足时不启用「无摘录常识作答」（减少编造，默认 0）；1=允许旧行为
# WEB_DIRECT_FALLBACK=0
# 上传附件摘录达到该字数时优先「仅依据文档」合成（跳过联网常识/direct_knowledge）
# ATTACHMENT_SYNTH_MIN_CHARS=400
# 工艺流程图 / PPT：POST /api/v1/artifacts/flowchart 与 /api/v1/artifacts/pptx；检索响应字段 artifacts
# 书籍问法（《书名》/按章节总结）：多路检索「目录/序言/出版社」并 book_clue 合成（见 backend/bookWebClues.js）
# BOOK_WEB_INCLUDE_MIN_SCORE=4
# BOOK_WEB_LIST_FALLBACK_CAP=20
# 1=作答仅用强相关摘录，不补弱锚点/兜底页（默认 1，更准确）
# WEB_SYNTH_STRICT=1
# A/B 联网作答与 C 仲裁：强相关摘录最少条数（严格模式下不足则少答或不臆测）
# WEB_SYNTH_MIN_SOURCES=4
# 网页/专利摘录进入作答 prompt 的分数下限（越大越严，企业问法可 22～28）
# WEB_SYNTH_MIN_WEB_SCORE=24
# WEB_SYNTH_MIN_PATENT_SCORE=18
# 弱锚点补足时的分数下限（WEB_SYNTH_STRICT=1 时不使用弱锚点）
# WEB_SYNTH_SOFT_MIN_WEB_SCORE=14
# WEB_SYNTH_SOFT_MIN_PATENT_SCORE=10
# 网页检索条数 / 全网覆盖（企业问法可略放宽 WEB_INCLUDE_MIN_SCORE=10）
# WEB_SEARCH_DEFAULT_MAX=128
# WEB_SEARCH_MAX_CAP=320
# WEB_MULTI_QUERY_MAX=16
# WEB_ROUND2_QUERY_MAX=2
# 第二轮跟进总等待上限（毫秒）
# WEB_ROUND2_TIMEOUT_MS=12000
# 书籍救援总等待上限（毫秒）
# WEB_BOOK_RESCUE_TIMEOUT_MS=15000
# WEB_MERGE_PER_QUERY_CAP=128
# WEB_MERGE_PER_SOURCE_CAP=52
# WEB_SOURCE_RESULT_CAP=45
# WEB_FETCH_MAX_PAGES=32
# WEB_SEARCH_RECALL=1
# 高召回网页列表（仍会剔除明显跑题页）
# WEB_LIST_FALLBACK_CAP=48
# WEB_LIST_SALVAGE_MIN=12
# WEB_INCLUDE_MIN_SCORE=4
# WEB_SYNTH_MIN_WEB_SCORE=16
# WEB_SYNTH_PICK_MAX=30
# WEB_LIST_FALLBACK_CAP=36
# WEB_SEARCH_LAYER_TIMEOUT_MS=70000

# 必填（Brave 官方 MCP）：到 https://brave.com/search/api/ 申请 Search API Key 后粘贴。
# 未填或无效时子进程常会立刻退出，界面会出现 mcp_web:err:MCP error -32000: Connection closed。
BRAVE_API_KEY=

# Windows 一般用 npx.cmd；Linux / macOS 改为 npx
MCP_WEB_COMMAND=npx.cmd
MCP_WEB_ARGS_JSON=["-y","@modelcontextprotocol/server-brave-search"]
MCP_WEB_TOOL=brave_web_search

# 检索到的网页链接抓取正文并写入 papers 表（SQLite；若配置 DATABASE_URL 则同步 PG）
# WEB_FETCH_ENABLED=1
# WEB_FETCH_MAX_PAGES=12
# 网页正文抓取并发数（默认 4，最多 6）
# WEB_FETCH_CONCURRENCY=4
# WEB_FETCH_TIMEOUT_MS=14000
# WEB_FETCH_MAX_CHARS=6000

# 可选
# MCP_WEB_MAX_RESULTS=8
# 首次 npx -y 下载包较慢，若总超时把下面调到 90000～120000
# MCP_WEB_TIMEOUT_MS=90000
# 瞬断 -32000 时自动重连次数（默认 3）
# MCP_WEB_ATTEMPTS=3
# MCP_WEB_TOOL_ARGS_JSON={"count":8}

# Tavily 搜索引擎 API（推荐）：POST https://api.tavily.com/search；WEB_SOURCES 含 tavily
# TAVILY_API_KEY=
# TAVILY_MCP_URL=https://mcp.tavily.com/mcp/?tavilyApiKey=YOUR_KEY
# TAVILY_WEB_MAX_RESULTS=15
# TAVILY_SEARCH_DEPTH=basic

# Wikipedia（MediaWiki API，无需 Key）
# WIKIPEDIA_LANG=zh
# WIKIPEDIA_TIMEOUT_MS=10000
# WIKIPEDIA_MAX_RESULTS=20
# CORE 开放获取论文 API（需要在 core.ac.uk 申请 API Key）
# CORE_API_KEY=
# CORE_TIMEOUT_MS=15000
# CORE_MAX_RESULTS=20
# Dataify Google 网页搜索（可选；需要 Dataify API Key）
# DATAIFY_API_KEY=
# DATAIFY_REQUEST_URL=https://scraperapi.dataify.com/request
# DATAIFY_GOOGLE_DOMAIN=google.com
# DATAIFY_GOOGLE_HL=zh-cn
# DATAIFY_GOOGLE_GL=cn
# DATAIFY_WEB_MAX_RESULTS=20
# Dataify 通用采集 / Web Unlocker（按 URL 抓 HTML；与谷歌搜索共用 DATAIFY_API_KEY）
# 默认 fallback：直连失败或反爬页时自动调用（约 15 元/千次成功请求）
# DATAIFY_WEBUNLOCKER_ENABLED=1
# DATAIFY_WEBUNLOCKER_URL=https://webunlocker.dataify.com/request
# DATAIFY_WEBUNLOCKER_MODE=fallback
# DATAIFY_WEBUNLOCKER_JS_RENDER=True
# DATAIFY_WEBUNLOCKER_COUNTRY=us
# DATAIFY_WEBUNLOCKER_TYPE=html
# DATAIFY_WEBUNLOCKER_TIMEOUT_MS=45000
# 联调：node scripts/dataify-webunlocker-test.mjs
# Dataify 网页采集 Builder（首请求：node scripts/dataify-first-request.mjs）
# DATAIFY_SCRAPER_URL=https://scraperapi.dataify.com/builder
# 旧版 GET Search（一般不用）：DATAIFY_LEGACY_SEARCH=1 + DATAIFY_API_BASE / DATAIFY_WEB_PATH
# DATAIFY_WEB_QUERY_PARAM=q
# DATAIFY_WEB_METHOD=GET
# DATAIFY_AUTH_HEADER=Authorization
# DATAIFY_AUTH_PREFIX=Bearer 
# DATAIFY_WEB_TIMEOUT_MS=14000
# DATAIFY_WEB_MAX_RESULTS=15
# 与控制台文档不一致时可用完整 URL（{{QUERY}} 会被 URL 编码替换）
# DATAIFY_WEB_URL=
# POST 时 JSON 模板，{{QUERY}} / {{API_KEY}} 会按 JSON 字符串规则转义后替换
# DATAIFY_WEB_BODY_JSON=
# DATAIFY_EXTRA_HEADERS_JSON={}

# ---------- A/B/C 原子 Provider（综述、附件、Web Tri、Deep Mine 三路抽取）----------
# A、B：固定使用 OpenAI-compatible Chat Completions，各自配置 base URL + API Key + model。
# C：固定使用 Gemini Developer API 原生 generateContent；BASE_URL 不含 model、:generateContent 或 key 查询参数。
# 任一槽只要填写了下面任意字段，就必须把该槽的 API_KEY / BASE_URL / MODEL 一并填全。
# 学生证认证使用模型 A，请确保该模型支持图片输入。
# LLM_PROVIDER_A_API_KEY=
# LLM_PROVIDER_A_BASE_URL=https://provider-a.example/v1
# LLM_PROVIDER_A_MODEL=gpt-5.5
# LLM_PROVIDER_B_API_KEY=
# LLM_PROVIDER_B_BASE_URL=https://provider-b.example/v1
# LLM_PROVIDER_B_MODEL=qwen3.7-max
# LLM_PROVIDER_C_API_KEY=
# LLM_PROVIDER_C_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# LLM_PROVIDER_C_MODEL=gemini-3.1-pro
# 联网综合由 A/B 独立作答、C 读取两份草稿后仲裁终稿；界面对照区仅显示 A/B 草稿。
WEB_TRI_MODE=tri
# 1=A/B 串行，2=A/B 并行（推荐、默认）；旧值 3 兼容并按 2 处理。正式仲裁 C 仍在 A/B 完成后调用。
WEB_TRI_CONCURRENCY=2
# 流式请求中，A 草稿作为临时预览，A/B 完成后由 C 仲裁并用终稿原子替换；旧 WEB_STREAM_SPECULATIVE 配置已不再启用 C-preview。
WEB_STREAM_SPECULATIVE=0
# 修改 Provider 或 WEB_TRI_* 后必须重启 API 进程。
# 兼容旧部署：A/B 仍读取 SYNTHESIS_API_KEY_*、SYNTHESIS_CHAT_URL_*、SYNTHESIS_MODEL_*。
# C 密钥优先读取 SYNTHESIS_API_KEY_C，其次 GEMINI_API_KEY；模型优先读取 SYNTHESIS_MODEL_C，其次 LLM_MODEL_C。
# C 地址优先读取 GEMINI_BASE_URL，其次 Gemini CLI 的 GOOGLE_GEMINI_BASE_URL，均未设置时默认 Google v1beta。
# 中转若要求 /v1beta，必须将其显式包含在 BASE_URL 中；程序只追加 /models/<model>:generateContent，
# 不会按域名猜测或为所有 Gemini 代理自动补版本路径。
# C 不读取 SYNTHESIS_CHAT_URL_C 或宽泛的 GOOGLE_API_KEY，避免继承 OpenAI 地址或其他 Google 服务凭据。
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GOOGLE_GEMINI_BASE_URL=https://code.newcli.com/gemini/v1beta
# 综述单次 LLM 超时（毫秒），默认 120000；上游易 504 时可设 180000～240000
# SYNTHESIS_TIMEOUT_MS=180000

# Elsevier Scopus（爱思唯尔）— 前端选择「网页」渠道时 **必填**，否则检索将报错（须遵守 dev.elsevier.com 条款）
# 申请：https://dev.elsevier.com/apikey/manage
# ELSEVIER_API_KEY=
# 机构 Token（可选，与 API Key 组合）：https://dev.elsevier.com/tecdoc_api_authentication.html
# ELSEVIER_INST_TOKEN=

# 仅开发：若暂时无 Scopus Key 又要测网页渠道其它逻辑，可设 1（生产勿用）
# ALLOW_WEB_WITHOUT_ELSEVIER=1

# OpenAlex 礼貌池（建议填写真实邮箱，便于 API 限流与联系）
# OPENALEX_CONTACT_EMAIL=you@example.com

# Unpaywall OA 查询（与 OPENALEX_CONTACT_EMAIL 二选一即可；用于界面「OA PDF」按钮）
# UNPAYWALL_EMAIL=you@example.com

# 自建 PostgreSQL（设置后不再使用本地 app.sqlite；表结构启动时自动创建）
# DATABASE_URL=postgresql://用户:密码@127.0.0.1:5432/论文库

# 启动时导入演示 JSON（backend/data/simple-papers.json + simple datas/*.json）；不设则跳过
# SIMPLE_SEED=1

# 侧栏身份「材料 MatSciBERT（NER）」：服务端用 Python 加载该目录下的 pipeline.py + MatSciBERT 权重做实体抽取后并入检索句
# MATSCI_PIPELINE_ROOT=E:\15w
# 含 torch/transformers/nltk 等的解释器（若默认 python 不对可填 conda 环境路径）
# MATSCI_PYTHON=python
# 跳过 CRF 以加快加载（默认 1）；要与 15w 完整训练权重一致可设 0
# MATSCI_NER_NO_CRF=1
# 完全关闭 NER 扩写（仍保留身份 skill 文本）
# MATSCI_NER_DISABLE=1
# 深度检索（POST /api/v1/search 传 deepMine）：默认对**全部**检索结果中有 PDF 的篇数逐篇下载 → MinerU(pipeline) → 三模型各抽关键词 → deepSynthesis
# 若需限制篇数（省时间/流量），取消注释并设正整数，例如：
# DEEP_MINE_MAX_PAPERS=3
# DEEP_MINE_MAX_PDF_MB=20
# DEEP_MINE_MINERU_TIMEOUT_MS=600000
# 未配置完整 A/B/C Provider 时，三路抽取可在主 Provider 上使用以下三个模型；配置 A/B/C 后优先使用各槽模型。
# DEEP_MINE_MODEL_1=deepseek-v4-flash
# DEEP_MINE_MODEL_2=deepseek-chat
# DEEP_MINE_MODEL_3=deepseek-v4-flash
# 指定 MinerU 可执行文件（默认自动找项目 .venv-mineru）
# MINERU_EXE=C:\...\mineru.exe

# 已在项目根创建 .venv-mineru 并 pip install mineru；当前解析到 3.0.4（与 mineru[all] 最新版在 Windows 上可能因 lmdeploy 等依赖回退）。
# 激活:  .\.venv-mineru\Scripts\Activate.ps1
# 单文件:  mineru -p "路径\论文.pdf" -o "路径\输出目录" -b pipeline -l ch
# 或:  .\scripts\mineru_scan.ps1 -Pdf "路径\论文.pdf"
# Server PDF library. Keep PDF bytes on the server filesystem; PostgreSQL
# stores searchable metadata and the relative file path.
LOCAL_PDF_IMPORT_ROOT=/home/ubuntu/papers
