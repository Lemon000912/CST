# 在此行粘贴 Brave Search API Key（不要提交本文件）
BRAVE_API_KEY=

MCP_WEB_COMMAND=npx
MCP_WEB_ARGS_JSON=["-y","@modelcontextprotocol/server-brave-search"]
MCP_WEB_TOOL=brave_web_search

# Dataify（同一 Token）：谷歌搜索 + 网页采集 Builder
DATAIFY_API_KEY=tz4sr1yrbwqlwd9brh4mvwmy7ppqaob2
DATAIFY_REQUEST_URL=https://scraperapi.dataify.com/request
DATAIFY_GOOGLE_DOMAIN=google.com
DATAIFY_GOOGLE_HL=zh-cn
DATAIFY_GOOGLE_GL=cn
DATAIFY_WEB_MAX_RESULTS=20
DATAIFY_SCRAPER_URL=https://scraperapi.dataify.com/builder
# 通用采集：直连失败时回退（与谷歌搜索共用上方 DATAIFY_API_KEY）
DATAIFY_WEBUNLOCKER_URL=https://webunlocker.dataify.com/request
DATAIFY_WEBUNLOCKER_MODE=fallback
DATAIFY_WEBUNLOCKER_JS_RENDER=True
DATAIFY_WEBUNLOCKER_COUNTRY=us
DATAIFY_WEBUNLOCKER_TIMEOUT_MS=45000

# Tavily 网页搜索（REST API；MCP 链接仅备用提取 Key，后端不连远程 MCP SSE）
TAVILY_API_KEY=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
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/?tavilyApiKey=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
TAVILY_WEB_MAX_RESULTS=20
TAVILY_SEARCH_DEPTH=advanced

# 网页渠道：Tavily + Dataify + SearX（召回模式可再加 qwant）
WEB_SOURCES=tavily,dataify,searx
# 1=偏召回（更多结果）；0=偏精准（更少跑题）
WEB_SEARCH_RECALL=1
WEB_BING_FAST_PATH=0
WEB_CN_BING_FALLBACK=1
WEB_REWRITE_USE_SYNTH_KEY=1
# 网页检索：适度并行 query，兼顾覆盖与速度
WEB_SEARCH_DEFAULT_MAX=120
WEB_SEARCH_MAX_CAP=280
WEB_MULTI_QUERY_MAX=6
WEB_ROUND2_QUERY_MAX=4
WEB_MERGE_PER_QUERY_CAP=112
WEB_MERGE_PER_SOURCE_CAP=48
WEB_SOURCE_RESULT_CAP=42
SEARXNG_INSTANCE_TRY=5
WEB_SEARX_MERGE_INSTANCES=1
WEB_SEARCH_LAYER_TIMEOUT_MS=85000
WEB_ROUND2_TIMEOUT_MS=32000
DATAIFY_WEB_TIMEOUT_MS=45000
WEB_FETCH_MAX_PAGES=32
WEB_INCLUDE_MIN_SCORE=8
WEB_LIST_FALLBACK_CAP=28
WEB_LIST_SALVAGE_MIN=8
WEB_CACHE_MIN_PAPERS=3
# 综合回答摘录：召回模式下自动允许弱相关锚点（仍禁跑题页）
WEB_SYNTH_STRICT=0
WEB_SYNTH_MIN_WEB_SCORE=14
WEB_SYNTH_MIN_PATENT_SCORE=10
WEB_SYNTH_MIN_SOURCES=2
WEB_SYNTH_PICK_MAX=28
WEB_DIRECT_FALLBACK=0

# Elsevier / Scopus
ELSEVIER_API_KEY=41fa484ebf35ef3e8f0ca4bea3b79621

# PostgreSQL 数据库配置
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/material_kb


