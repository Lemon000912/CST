# 网页三模型模式
WEB_TRI_MODE=tri
WEB_TRI_CONCURRENCY=1
WEB_STREAM_SPECULATIVE=0
WEB_ANSWER_MAX_TOKENS=3200
WEB_ANSWER_FAST_MODEL=0
WEB_ANSWER_RETRIES=3
WEB_LITE_MAX_PAPERS=5
WEB_ULTRA_LITE_MAX_PAPERS=3
# 综述/仲裁超时（毫秒）
SYNTHESIS_TIMEOUT_MS=240000
REWRITE_TIMEOUT_MS=12000
 
USER_DB_ENABLED=true
USER_DB_TYPE=sqlite
USER_DB_PATH=./server/data/users

# 用户Skill默认配置
DEFAULT_PERSONA_ID=researcher
DEFAULT_FAVORITE_TOPICS=
ENABLE_USER_SKILL_TRACKING=true

# ==================== GStack & GBrain 配置 ====================
# GStack - 基于图的结果融合排序
ENABLE_GSTACK=true
# 相似度阈值 (0-1)，低于此值不建立边
GSTACK_SIMILARITY_THRESHOLD=0.6
# PageRank阻尼因子
GSTACK_DAMPING_FACTOR=0.85
# 最大迭代次数
GSTACK_MAX_ITERATIONS=100

# GBrain - 知识图谱大脑
ENABLE_GBRAIN=true
# 最大实体数
GBRAIN_MAX_ENTITIES=10000
# 时间衰减因子
GBRAIN_DECAY_FACTOR=0.95
# 最小出现次数（低于此值的实体会被清理）
GBRAIN_MIN_OCCURRENCE=2

# ==================== 开发环境配置 ====================
